default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight using App Store Connect API Key"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content.to_s.empty?
      UI.user_error!("[CONFIGURAÇÃO NECESSÁRIA] As credenciais da App Store Connect API Key não foram encontradas no GitHub Secrets.\nPor favor, adicione os secrets: APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID e APP_STORE_CONNECT_API_KEY_KEY.")
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true,
      in_house: false
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "Rotas.xcodeproj"
    )

    key_path = File.expand_path("~/AuthKey_#{key_id}.p8")
    File.write(key_path, api_key[:key])
    UI.message("Wrote API key to file: #{key_path}")

    xcargs_str = "-allowProvisioningUpdates -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id} -authenticationKeyPath #{key_path}"

    build_app(
      project: "Rotas.xcodeproj",
      scheme: "Rotas",
      export_method: "app-store",
      clean: true,
      xcargs: xcargs_str,
      export_options: {
        allowProvisioningUpdates: true,
        authenticationKeyID: key_id,
        authenticationKeyIssuerID: issuer_id,
        authenticationKeyPath: key_path
      },
      output_directory: "./build",
      output_name: "Rotas.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
