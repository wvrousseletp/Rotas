require "base64"

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight using App Store Connect API Key"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_content_b64 = ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content_b64.to_s.empty?
      UI.user_error!("[CONFIGURAÇÃO NECESSÁRIA] As credenciais da App Store Connect API Key não foram encontradas no GitHub Secrets.\nPor favor, adicione os secrets: APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID e APP_STORE_CONNECT_API_KEY_KEY.")
    end

    key_filepath = File.expand_path("~/AuthKey_#{key_id}.p8")
    decoded_p8 = Base64.decode64(key_content_b64.gsub(/\s+/, ''))
    File.binwrite(key_filepath, decoded_p8)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: decoded_p8,
      is_key_content_base64: false,
      in_house: false
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "Rotas.xcodeproj"
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # Ensure Bundle ID and App exist on Developer Portal and App Store Connect using API Key
    bundle_id = nil
    begin
      bundle_id = Spaceship::ConnectAPI::BundleId.find("com.wvrousseletp.Rotas")
      if bundle_id.nil?
        UI.message("Creating Bundle ID com.wvrousseletp.Rotas on Developer Portal...")
        bundle_id = Spaceship::ConnectAPI.post_bundle_id(
          name: "Rotas",
          identifier: "com.wvrousseletp.Rotas",
          platform: "IOS",
          seed_id: ENV["DEVELOPMENT_TEAM"] || "CR85ZZCSUA"
        )
        UI.success("Successfully created Bundle ID: #{bundle_id.identifier}")
      else
        UI.message("Bundle ID com.wvrousseletp.Rotas exists.")
      end
    rescue => e
      UI.error("Bundle ID setup note: #{e.message}")
    end

    begin
      app = Spaceship::ConnectAPI::App.find("com.wvrousseletp.Rotas")
      if app.nil?
        UI.message("Creating App Rotas on App Store Connect...")
        bundle_id_obj = bundle_id || Spaceship::ConnectAPI::BundleId.find("com.wvrousseletp.Rotas")
        if bundle_id_obj
          app = Spaceship::ConnectAPI.post_app(
            name: "Rotas",
            primary_locale: "en-US",
            sku: "com.wvrousseletp.Rotas",
            bundle_id_id: bundle_id_obj.id
          )
          UI.success("Successfully created App: #{app.name}")
        end
      else
        UI.message("App Rotas exists on App Store Connect.")
      end
    rescue => e
      UI.error("App setup note: #{e.message}")
    end

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.wvrousseletp.Rotas",
      development: false,
      skip_certificate_verification: true
    )

    xcargs_str = "-allowProvisioningUpdates -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id} -authenticationKeyPath #{key_filepath}"

    build_app(
      project: "Rotas.xcodeproj",
      scheme: "Rotas",
      export_method: "app-store",
      clean: true,
      xcargs: xcargs_str,
      export_options: {
        allowProvisioningUpdates: true,
        authenticationKeyID: key_id,
        authenticationKeyIssuerID: issuer_id,
        authenticationKeyPath: key_filepath
      },
      output_directory: "./build",
      output_name: "Rotas.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
