require "base64"

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight using App Store Connect API Key"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_content_b64 = ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content_b64.to_s.empty?
      UI.user_error!("[CONFIGURAÇÃO NECESSÁRIA] As credenciais da App Store Connect API Key não foram encontradas no GitHub Secrets.\nPor favor, adicione os secrets: APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID e APP_STORE_CONNECT_API_KEY_KEY.")
    end

    key_filepath = File.expand_path("~/AuthKey_#{key_id}.p8")
    decoded_p8 = Base64.decode64(key_content_b64.gsub(/\s+/, ''))
    File.binwrite(key_filepath, decoded_p8)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: decoded_p8,
      is_key_content_base64: false,
      in_house: false
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "Rotas.xcodeproj"
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # Check existing iOS Distribution certificates; if limit reached, revoke the oldest one so Fastlane cert can create a new one with private key
    begin
      all_certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = all_certs.select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") || c.certificate_type.to_s.include?("IOS_DISTRIBUTION") }
      UI.message("Found #{dist_certs.count} iOS Distribution certificate(s) on Apple Developer Portal.")
      if dist_certs.count >= 2
        oldest_cert = dist_certs.sort_by { |c| c.expiration_date || "" }.first
        UI.important("Distribution certificate limit reached. Revoking oldest certificate (#{oldest_cert.id}) to allow CI certificate creation...")
        oldest_cert.delete!
        UI.success("Successfully revoked certificate: #{oldest_cert.id}")
      end
    rescue => e
      UI.error("Certificate management note: #{e.message}")
    end

    keychain_db_path = File.expand_path("~/Library/Keychains/ci_keychain-db")

    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: keychain_db_path
    )

    # Ensure Bundle ID, App and Provisioning Profile exist on Developer Portal and App Store Connect using API Key
    begin
      b_id = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: "com.wvrousseletp.Rotas" }).first
      if b_id.nil?
        UI.message("Creating Bundle ID com.wvrousseletp.Rotas on Developer Portal...")
        b_id = Spaceship::ConnectAPI.post_bundle_id(
          name: "Rotas",
          identifier: "com.wvrousseletp.Rotas",
          platform: "UNIVERSAL",
          seed_id: ENV["DEVELOPMENT_TEAM"] || "CR85ZZCSUA"
        )
        UI.success("Successfully created Bundle ID: #{b_id.identifier}")
      else
        UI.message("Bundle ID com.wvrousseletp.Rotas found: #{b_id.id}")
      end

      app_obj = Spaceship::ConnectAPI::App.all(filter: { bundleId: b_id.id }).first
      if app_obj.nil?
        UI.message("Creating App Rotas on App Store Connect...")
        app_obj = Spaceship::ConnectAPI.post_app(
          name: "Rotas",
          primary_locale: "en-US",
          sku: "com.wvrousseletp.Rotas",
          bundle_id_id: b_id.id
        )
        UI.success("Created App on App Store Connect: #{app_obj.name}")
      else
        UI.message("App Rotas exists on App Store Connect.")
      end

      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
      cert_obj = cert_id ? Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == cert_id } : Spaceship::ConnectAPI::Certificate.all.select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }.first

      if cert_obj
        profiles = Spaceship::ConnectAPI::Profile.all(filter: { bundleId: b_id.id, profileType: "IOS_APP_STORE" })
        prof = profiles.first
        if prof.nil?
          UI.message("Creating App Store Provisioning Profile for com.wvrousseletp.Rotas...")
          prof = Spaceship::ConnectAPI::Profile.create(
            name: "Rotas AppStore Profile",
            profile_type: "IOS_APP_STORE",
            bundle_id_id: b_id.id,
            certificate_ids: [cert_obj.id]
          )
          UI.success("Created Provisioning Profile: #{prof.name}")
        else
          UI.message("Provisioning Profile found: #{prof.name}")
        end

        if prof && prof.profile_content
          profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
          FileUtils.mkdir_p(profiles_dir)
          prof_filepath = File.join(profiles_dir, "#{prof.uuid}.mobileprovision")
          File.binwrite(prof_filepath, Base64.decode64(prof.profile_content))
          UI.success("Installed Provisioning Profile #{prof.uuid}.mobileprovision to #{prof_filepath}")
          lane_context[:CURRENT_PROF_UUID] = prof.uuid
          lane_context[:CURRENT_PROF_NAME] = prof.name
        end
      end
    rescue => e
      UI.error("ConnectAPI setup note: #{e.message}")
    end

    target_profile = lane_context[:CURRENT_PROF_UUID] || lane_context[:CURRENT_PROF_NAME] || "Rotas AppStore Profile"
    xcargs_str = "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=\"#{target_profile}\" DEVELOPMENT_TEAM=\"#{ENV['DEVELOPMENT_TEAM'] || 'CR85ZZCSUA'}\""

    build_app(
      project: "Rotas.xcodeproj",
      scheme: "Rotas",
      export_method: "app-store",
      clean: true,
      xcargs: xcargs_str,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.wvrousseletp.Rotas" => target_profile
        }
      },
      output_directory: "./build",
      output_name: "Rotas.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
